# Puerto HTTP de la aplicación (producción: 43128)
PORT=43128

# Ruta de la base SQLite (en Docker usar /app/data/conciliacion.db)
DB_PATH=data/conciliacion.db

# production activa login y sirve el frontend desde dist/
NODE_ENV=development

# Obligar login también en desarrollo (opcional)
# AUTH_REQUIRED=true

# Credenciales del administrador de esta instalación
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar-esta-clave

# Secreto para firmar cookies de sesión (generar uno aleatorio en producción)
SESSION_SECRET=generar-un-secreto-largo-y-aleatorio

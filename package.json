{
  "name": "conciliacion-cuenta-h",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run check && vite build",
    "start": "NODE_ENV=production tsx src/server.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "latest",
    "express": "latest",
    "multer": "latest",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@types/better-sqlite3": "latest",
    "@types/express": "latest",
    "@types/multer": "latest",
    "@types/node": "^26.6.3",
    "concurrently": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}

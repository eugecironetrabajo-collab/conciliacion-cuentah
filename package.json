{
  "name": "conciliacion-cuenta-h",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run check && vite build",
    "build:firebase": "node scripts/check-firebase-production-env.mjs && npm run check && BUILD_ID=$(date -u +%Y%m%d-%H%MZ) vite build --mode production",
    "firebase:env-init": "node scripts/firebase-env-init.mjs",
    "firebase:pull-env": "node scripts/pull-firebase-web-env.mjs",
    "firebase:deploy": "npm run build:firebase && firebase deploy --only hosting,firestore",
    "emulators": "bash scripts/emulators.sh",
    "emulators:stop": "bash scripts/emulators-stop.sh",
    "emulators:smoke": "node scripts/emulator-smoke.mjs",
    "emulators:user": "node scripts/create-emulator-user.mjs",
    "start": "NODE_ENV=production tsx src/server.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "latest",
    "buffer": "^6.0.3",
    "express": "latest",
    "firebase": "^13.0.0",
    "multer": "latest",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@types/better-sqlite3": "latest",
    "@types/express": "latest",
    "@types/multer": "latest",
    "@types/node": "^26.6.3",
    "concurrently": "latest",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}

# Copie a web/.env.local para desarrollo con Firestore (emulador o nube Spark)
VITE_BACKEND=firestore
VITE_FIREBASE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-conciliacion
VITE_FIREBASE_STORAGE_BUCKET=demo-conciliacion.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:0

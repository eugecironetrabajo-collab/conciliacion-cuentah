# Copie a web/.env.production y complete con Firebase Console → Configuración → Su app web.
# NO use VITE_FIREBASE_EMULATOR en producción.
VITE_BACKEND=firestore
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=conciliacion-cuenta-h
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_EMULATOR=false
